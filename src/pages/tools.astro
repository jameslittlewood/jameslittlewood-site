---
import Layout from '@/layouts/Layout.astro'
import site from '@/config/site'
import ToolLogo from '@/components/blocks/ToolLogo.astro'
import { Icon } from 'astro-icon/components'
---

<Layout title={site.labels.toolsTitle} description={site.labels.toolsTitle}>
	<div
		class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl p-8 duration-700 md:p-16"
	>
		<h2 class="mb-12 text-3xl font-bold">{site.labels.toolsTitle}</h2>

		<div class="space-y-8">
			{
				site.tools.map((category) => (
					<section>
						<h3 class="mb-4 text-xs font-bold tracking-widest text-primary uppercase">
							{category.name}
						</h3>
						<div class="grid grid-cols-2 gap-3 md:grid-cols-3">
							{category.items.map((item) =>
								item.link ? (
									<a
										href={item.link}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${item.name} (opens in a new tab)`}
										class="group relative flex items-center gap-2.5 rounded-xl border border-border/50 bg-muted/20 px-4 py-3 text-sm text-foreground/80 transition-all duration-300 hover:border-primary/40 hover:bg-muted/30 hover:text-primary motion-safe:hover:-translate-y-0.5 hover:shadow-sm"
									>
										<ToolLogo
											name={item.name}
											logo={item.logo}
											icon={item.icon}
											class="h-4 w-4 shrink-0 text-primary/60"
										/>
										<span>{item.name}</span>
										<Icon
											name="mdi:open-in-new"
											size={12}
											aria-hidden="true"
											class="pointer-events-none absolute top-1 right-1 text-primary opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
										/>
									</a>
								) : (
									<div class="flex items-center gap-2.5 rounded-xl border border-border/50 bg-muted/20 px-4 py-3 text-sm text-foreground/80">
										<ToolLogo
											name={item.name}
											logo={item.logo}
											icon={item.icon}
											class="h-4 w-4 shrink-0 text-primary/60"
										/>
										<span>{item.name}</span>
									</div>
								)
							)}
						</div>
					</section>
				))
			}
		</div>
	</div>
</Layout>
