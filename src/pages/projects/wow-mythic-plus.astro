---
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import ChartCard from '@/components/wow/ChartCard.astro'
---

<Layout
	title="Mythic+ Leaderboard Analytics"
	description="An interactive view of collected top Mythic+ leaderboard runs, reported class and specialisation representation, team compositions, timings and key levels."
>
	<article class="mx-auto max-w-3xl space-y-8 p-6 sm:p-8 md:p-10">
		<a
			href="/projects/"
			class="inline-flex items-center gap-2 text-sm text-primary hover:underline"
		>
			← Back to Projects
		</a>

		<header class="space-y-4">
			<div class="inline-flex flex-wrap items-center gap-2">
				<span
					class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary"
				>
					Interactive dashboard
				</span>
				<span
					class="rounded-full border border-border bg-muted/30 px-3 py-1 text-xs text-muted-foreground"
				>
					Static JSON · no direct database
				</span>
			</div>
			<h1 class="text-3xl font-bold tracking-tight">
				Mythic+ Leaderboard Analytics
			</h1>
			<p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
				An interactive view of <strong class="font-semibold text-foreground"
					>collected top leaderboard runs</strong
				> for one dungeon and season. Filter runs, compare key levels, inspect reported
				roster composition and read run-level timings. This is a leaderboard sample,
				not the whole Mythic+ population.
			</p>
			<div
				class="flex flex-wrap gap-2"
				role="group"
				aria-label="Published dataset scope"
			>
				<span
					class="rounded-full border border-primary/20 bg-primary/5 px-3 py-1 font-mono text-xs text-primary"
					data-scope-region>EU</span
				>
				<span
					class="rounded-full border border-primary/20 bg-primary/5 px-3 py-1 font-mono text-xs text-primary"
					data-scope-season>season-mn-2</span
				>
				<span
					class="rounded-full border border-primary/20 bg-primary/5 px-3 py-1 font-mono text-xs text-primary"
					data-scope-dungeon>Den of Nalorakk</span
				>
			</div>
			<p class="text-xs text-muted-foreground">
				Only this scope is published. Region, season and dungeon selectors are
				intentionally absent until additional datasets exist.
			</p>
		</header>

		<noscript>
			<div class="wow-warning rounded-2xl border p-4 text-sm">
				This dashboard needs JavaScript to load the validated JSON dataset and
				draw charts. The underlying JSON remains available at
				<code class="font-mono text-xs"
					>/data/wow-mythic-plus/manifest.json</code
				>.
			</div>
		</noscript>

		<div
			data-dashboard-loading
			role="status"
			aria-live="polite"
			class="rounded-2xl border border-border/60 bg-muted/20 p-6 text-sm text-muted-foreground"
		>
			Loading the validated Mythic+ dataset…
		</div>

		<div
			data-dashboard-error
			hidden
			role="alert"
			class="wow-error rounded-2xl border p-5"
		>
			<h2 class="text-sm font-bold">The dashboard data could not be loaded</h2>
			<p class="mt-2 text-sm text-muted-foreground" data-error-message></p>
			<p class="mt-2 text-xs text-muted-foreground">
				No fallback dataset is used. Check that the validated static JSON was
				synced and that its schema version is compatible.
			</p>
			<button
				type="button"
				data-retry
				class="mt-4 rounded-xl border border-primary/30 bg-primary/10 px-3 py-2 text-xs font-semibold text-primary hover:bg-primary/20 focus-visible:rounded-xl"
			>
				Retry
			</button>
		</div>

		<div data-wow-dashboard hidden class="space-y-8">
			<div
				data-dataset-stale
				hidden
				role="status"
				class="wow-warning rounded-2xl border p-4 text-sm"
			>
				This published dataset is more than 14 days old. Treat it as a
				historical snapshot until a newer collection is published.
			</div>
			<div
				data-dataset-incomplete
				hidden
				role="status"
				class="wow-warning rounded-2xl border p-4 text-sm"
			>
			</div>

			<section aria-labelledby="at-a-glance-title" class="space-y-3">
				<div class="flex flex-wrap items-end justify-between gap-2">
					<div>
						<h2 id="at-a-glance-title" class="text-lg font-bold">
							At a glance
						</h2>
						<p class="text-xs text-muted-foreground">
							Metrics recalculate from the filtered run population.
						</p>
					</div>
					<span
						class="rounded-full border border-border bg-muted/30 px-3 py-1 text-[11px] text-muted-foreground"
						data-dataset-version></span>
				</div>
				<div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
					<div class="rounded-2xl border border-border/60 bg-card p-4">
						<p
							class="text-[11px] font-bold tracking-widest text-muted-foreground uppercase"
						>
							Collected runs
						</p>
						<p class="mt-2 text-2xl font-bold tabular-nums" data-kpi="runs">
							—
						</p>
						<p
							class="mt-1 text-xs text-muted-foreground"
							data-kpi="runs-detail"
						>
							—
						</p>
					</div>
					<div class="rounded-2xl border border-border/60 bg-card p-4">
						<p
							class="text-[11px] font-bold tracking-widest text-muted-foreground uppercase"
						>
							Highest key
						</p>
						<p class="mt-2 text-2xl font-bold tabular-nums" data-kpi="highest">
							—
						</p>
						<p
							class="mt-1 text-xs text-muted-foreground"
							data-kpi="key-average"
						>
							—
						</p>
					</div>
					<div class="rounded-2xl border border-border/60 bg-card p-4">
						<p
							class="text-[11px] font-bold tracking-widest text-muted-foreground uppercase"
						>
							Roster sample
						</p>
						<p
							class="mt-2 text-2xl font-bold tabular-nums"
							data-kpi="appearances"
						>
							—
						</p>
						<p
							class="mt-1 text-xs text-muted-foreground"
							data-kpi="teams-detail"
						>
							—
						</p>
					</div>
					<div class="rounded-2xl border border-border/60 bg-card p-4">
						<p
							class="text-[11px] font-bold tracking-widest text-muted-foreground uppercase"
						>
							Coverage
						</p>
						<p class="mt-2 text-2xl font-bold tabular-nums" data-kpi="pages">
							—
						</p>
						<p
							class="mt-1 text-xs text-muted-foreground"
							data-kpi="pages-detail"
						>
							—
						</p>
					</div>
				</div>
				<div
					class="grid gap-2 rounded-2xl border border-border/50 bg-muted/20 p-4 text-xs text-muted-foreground sm:grid-cols-2"
				>
					<p>
						<span class="font-semibold text-foreground"
							>Observation window:</span
						>
						<span data-observation-window>—</span>
					</p>
					<p>
						<span class="font-semibold text-foreground">Last updated:</span>
						<span data-exported-at>—</span>
					</p>
					<p>
						<span class="font-semibold text-foreground">Collection:</span>
						<span data-collection-id>—</span>
					</p>
					<p>
						<span class="font-semibold text-foreground">Selection:</span>
						<span data-selection-method>—</span>
					</p>
				</div>
			</section>

			<section aria-labelledby="filters-title" class="space-y-4">
				<div>
					<h2 id="filters-title" class="text-lg font-bold">Filters</h2>
					<p class="text-xs text-muted-foreground">
						Run filters and search change the KPIs, charts and table. The roster
						role view changes appearance charts only; it does not remove runs.
					</p>
				</div>
				<div class="rounded-2xl border border-border/60 bg-card p-4 sm:p-5">
					<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
						<label class="block text-xs font-semibold" for="filter-key">
							Key level
							<select
								id="filter-key"
								data-filter-key
								class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2 text-sm font-normal text-foreground focus-visible:border-primary"
							>
								<option value="all">All key levels</option>
							</select>
						</label>
						<label class="block text-xs font-semibold" for="filter-class">
							Class present
							<select
								id="filter-class"
								data-filter-class
								class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2 text-sm font-normal text-foreground focus-visible:border-primary"
							>
								<option value="all">All classes</option>
							</select>
						</label>
						<label class="block text-xs font-semibold" for="filter-spec">
							Reported spec present
							<select
								id="filter-spec"
								data-filter-spec
								class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2 text-sm font-normal text-foreground focus-visible:border-primary"
							>
								<option value="all">All reported specs</option>
							</select>
						</label>
						<label class="block text-xs font-semibold" for="filter-search">
							Search runs
							<input
								id="filter-search"
								data-filter-search
								type="search"
								placeholder="Rank, run id, dungeon or spec"
								class="mt-1.5 w-full rounded-xl border border-border bg-background px-3 py-2 text-sm font-normal text-foreground placeholder:text-muted-foreground focus-visible:border-primary"
							/>
						</label>
					</div>
					<div
						class="mt-4 flex flex-wrap items-end justify-between gap-3 border-t border-border/50 pt-4"
					>
						<fieldset>
							<legend class="text-xs font-semibold"
								>Roster role view <span
									class="font-normal text-muted-foreground"
									>(appearance charts only)</span
								></legend
							>
							<div class="mt-2 flex flex-wrap gap-2" data-role-filter>
								<button
									type="button"
									data-role="all"
									aria-pressed="true"
									class="rounded-full border border-primary/30 bg-primary/10 px-3 py-1.5 text-xs font-semibold text-primary"
									>All roles</button
								>
								<button
									type="button"
									data-role="tank"
									aria-pressed="false"
									class="rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:border-primary/30 hover:text-primary"
									>Tank</button
								>
								<button
									type="button"
									data-role="healer"
									aria-pressed="false"
									class="rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:border-primary/30 hover:text-primary"
									>Healer</button
								>
								<button
									type="button"
									data-role="dps"
									aria-pressed="false"
									class="rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:border-primary/30 hover:text-primary"
									>DPS</button
								>
							</div>
						</fieldset>
						<button
							type="button"
							data-reset
							class="rounded-xl border border-border px-3 py-2 text-xs font-semibold text-muted-foreground hover:border-primary/30 hover:text-primary focus-visible:rounded-xl"
						>
							Reset filters
						</button>
					</div>
					<p
						class="mt-3 text-xs text-muted-foreground"
						data-filter-summary
						aria-live="polite"
					>
					</p>
				</div>
			</section>

			<section aria-labelledby="charts-title" class="space-y-4">
				<div>
					<h2 id="charts-title" class="text-lg font-bold">Charts</h2>
					<p class="text-xs text-muted-foreground">
						Descriptive distributions only. No class or specialisation strength
						claim is made.
					</p>
				</div>
				<div class="grid gap-4 lg:grid-cols-2">
					<ChartCard
						chart="key"
						title="Key-level distribution"
						description="Runs by reported Mythic+ key level in the filtered population."
					/>
					<ChartCard
						chart="class"
						title="Class appearances"
						description="Roster appearances by reported class. The denominator is roster slots in view, not distinct players."
					/>
					<ChartCard
						chart="spec"
						title="Reported specialisation"
						description="Reported specialisations by role. This is not verified run-time specialisation."
						height="h-80"
					/>
					<ChartCard
						chart="compositions"
						title="Most common team compositions"
						description="Sorted five-spec multisets from eligible complete rosters; repeated specs are preserved."
						height="h-80"
					/>
					<ChartCard
						chart="completion"
						title="Completion-time distribution"
						description="Reported clear time converted to seconds. Missing timings are excluded."
					/>
					<ChartCard
						chart="margin"
						title="Timer-margin analysis"
						description="Dungeon timer minus clear time. Positive bins are ahead of the timer; negative bins are overtime."
					/>
				</div>
			</section>

			<section aria-labelledby="leaderboard-title" class="space-y-4">
				<div class="flex flex-wrap items-end justify-between gap-3">
					<div>
						<h2 id="leaderboard-title" class="text-lg font-bold">
							Leaderboard runs
						</h2>
						<p class="text-xs text-muted-foreground">
							Search and sort the filtered runs. Source score is a leaderboard
							score with unverified semantics; it is not a run-details score.
						</p>
					</div>
					<p
						class="text-xs font-semibold text-muted-foreground"
						data-result-count
						aria-live="polite"
					>
					</p>
				</div>
				<div
					class="overflow-x-auto rounded-2xl border border-border/60"
					tabindex="0"
					role="region"
					aria-label="Leaderboard runs table, horizontally scrollable"
				>
					<table class="w-full min-w-[54rem] border-collapse text-left text-sm">
						<caption class="sr-only">
							Collected Mythic+ leaderboard runs with rank, dungeon, key level,
							timings, source score, reported composition and Raider.IO link.
						</caption>
						<thead
							class="border-b border-border bg-muted/40 text-[11px] tracking-widest text-muted-foreground uppercase"
						>
							<tr>
								<th scope="col" class="px-3 py-3" aria-sort="none">
									<button
										type="button"
										data-sort="rank"
										class="inline-flex min-h-6 min-w-6 items-center py-1 font-bold hover:text-primary focus-visible:rounded-sm"
										>Rank</button
									>
								</th>
								<th scope="col" class="px-3 py-3">
									<button
										type="button"
										data-sort="key"
										class="inline-flex min-h-6 min-w-6 items-center py-1 font-bold hover:text-primary focus-visible:rounded-sm"
										>Key</button
									>
								</th>
								<th scope="col" class="px-3 py-3">Dungeon</th>
								<th scope="col" class="px-3 py-3">
									<button
										type="button"
										data-sort="clear"
										class="inline-flex min-h-6 min-w-6 items-center py-1 font-bold hover:text-primary focus-visible:rounded-sm"
										>Clear</button
									>
								</th>
								<th scope="col" class="px-3 py-3">
									<button
										type="button"
										data-sort="margin"
										class="inline-flex min-h-6 min-w-6 items-center py-1 font-bold hover:text-primary focus-visible:rounded-sm"
										>Margin</button
									>
								</th>
								<th scope="col" class="px-3 py-3">
									<button
										type="button"
										data-sort="score"
										class="inline-flex min-h-6 min-w-6 items-center py-1 font-bold hover:text-primary focus-visible:rounded-sm"
										>Score</button
									>
								</th>
								<th scope="col" class="px-3 py-3">
									<button
										type="button"
										data-sort="composition"
										class="inline-flex min-h-6 min-w-6 items-center py-1 font-bold hover:text-primary focus-visible:rounded-sm"
										>Reported composition</button
									>
								</th>
								<th scope="col" class="px-3 py-3">Source</th>
							</tr>
						</thead>
						<tbody data-runs-body></tbody>
					</table>
					<div
						data-runs-empty
						hidden
						class="p-6 text-center text-sm text-muted-foreground"
					>
						No runs match the current filters. Reset the filters or search term
						to see the cohort.
					</div>
				</div>
			</section>

			<section
				aria-labelledby="definitions-title"
				class="rounded-2xl border border-border/60 bg-muted/20 p-5"
			>
				<h2 id="definitions-title" class="text-lg font-bold">
					How to read this
				</h2>
				<div
					class="mt-3 grid gap-4 text-xs leading-relaxed text-muted-foreground sm:grid-cols-2"
				>
					<div>
						<h3 class="mb-1 text-sm font-semibold text-foreground">
							Population
						</h3>
						<p>
							The default is the latest successful complete collection for this
							scope. Historical observations and unique runs ever discovered are
							reported separately by the export and are not mixed into these
							metric denominators.
						</p>
					</div>
					<div>
						<h3 class="mb-1 text-sm font-semibold text-foreground">
							Counts and percentages
						</h3>
						<p>
							A run is a distinct keystone run. A roster appearance is one
							reported slot, so the same character can appear in several runs.
							Complete teams contain five reported slots; class and spec
							team-presence percentages use complete teams only.
						</p>
					</div>
					<div>
						<h3 class="mb-1 text-sm font-semibold text-foreground">
							Reported specialisation
						</h3>
						<p>
							<code class="font-mono text-[11px]">character.spec</code> is not verified
							as the specialisation played at run completion. Charts and tables label
							it “reported specialisation”; do not treat it as historical run-time
							truth.
						</p>
					</div>
					<div>
						<h3 class="mb-1 text-sm font-semibold text-foreground">
							Performance
						</h3>
						<p>
							Timings and margins are descriptive. Key level, composition,
							player skill and selection effects are confounded, and the cohort
							is only the top two pages of one dungeon leaderboard. No
							class-strength or overall-popularity conclusion is valid.
						</p>
					</div>
				</div>
				<details class="mt-4 border-t border-border/50 pt-3">
					<summary
						class="cursor-pointer text-xs font-semibold text-primary focus-visible:rounded-sm"
					>
						Data definitions and source limitations
					</summary>
					<div
						class="mt-3 space-y-2 text-xs leading-relaxed text-muted-foreground"
						data-definitions
					>
					</div>
				</details>
			</section>

			<footer
				class="rounded-xl border border-border/50 bg-muted/20 p-4 text-xs leading-relaxed text-muted-foreground"
			>
				<p>
					Source: <a
						href="https://raider.io"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary underline underline-offset-4 hover:text-primary/80"
						>Raider.IO</a
					>
					public Mythic+ leaderboard API. This dashboard loads validated static JSON
					and never connects to PostgreSQL. Collected top leaderboard runs are not
					the complete Mythic+ population.
				</p>
				<p class="mt-2" data-footer-version></p>
			</footer>
		</div>
	</article>
</Layout>

<style>
	.wow-warning {
		border-color: color-mix(in oklch, var(--callout-warning) 45%, transparent);
		background: color-mix(in oklch, var(--callout-warning) 10%, transparent);
	}
	.wow-error {
		border-color: color-mix(in oklch, var(--callout-danger) 45%, transparent);
		background: color-mix(in oklch, var(--callout-danger) 10%, transparent);
	}
	.wow-positive {
		color: var(--callout-success);
	}
	.wow-negative {
		color: var(--callout-danger);
	}
</style>

<script>
	import { mountWowDashboard } from '@/lib/wowMythicDashboard'

	const start = () => {
		const root = document.querySelector<HTMLElement>('[data-wow-dashboard]')
		if (!root || root.dataset.mounted === 'true') return
		root.dataset.mounted = 'true'
		mountWowDashboard()
	}
	document.addEventListener('astro:page-load', start)
	if (document.readyState !== 'loading') start()
</script>
