---
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

const technologies = [
	'Open WebUI',
	'OpenRouter',
	'Unsloth Studio',
	'Qwen3.5 2B',
	'Gemma 4 12B',
	'Google DeepMind',
	'Docker',
	'Ubuntu Linux',
	'Cloudflare',
	'SearXNG',
	'GGUF',
	'DDGS',
	'PostgreSQL 16',
	'Homepage',
	'Glances',
	'Uptime Kuma',
	'Tailscale',
	'SSH',
	'macOS',
	'VS Code',
]

const features = [
	{
		title: 'Hybrid AI Models',
		description:
			'Open WebUI connects to OpenRouter cloud models, Ubuntu-hosted Qwen3.5 2B and Windows-hosted Gemma 4 12B through configured inference APIs.',
	},
	{
		title: 'Secure Remote Access',
		description:
			'Cloudflare Tunnel and Access provide authenticated browser access. The MacBook Pro uses Tailscale and SSH for remote administration of Ubuntu.',
	},
	{
		title: 'Web Search',
		description:
			'DDGS and self-hosted SearXNG integration for AI-assisted web search.',
	},
	{
		title: 'Document Retrieval',
		description:
			'Built-in retrieval-augmented generation (RAG) for conversations grounded in uploaded documents.',
	},
	{
		title: 'Assistant Presets',
		description:
			'Specialised AI assistants for Python, SQL, data analytics, research and document analysis.',
	},
	{
		title: 'Self-Hosted Infrastructure',
		description:
			'Ubuntu Linux and Docker host Open WebUI and supporting services, including PostgreSQL 16, Homepage, Glances and Uptime Kuma. Development uses VS Code on a MacBook Pro.',
	},
]

const modelLinks = {
	qwen: 'https://huggingface.co/unsloth/Qwen3.5-2B-GGUF',
	gemma: 'https://huggingface.co/unsloth/gemma-4-12b-it-GGUF',
}

const screenshots = [
	{
		featured:
			'/images/projects/self-hosted-ai-chatbot/open-webui-featured.webp',
		src: '/images/projects/self-hosted-ai-chatbot/open-webui.webp',
		thumbnail: '/images/projects/self-hosted-ai-chatbot/open-webui-thumb.webp',
		width: 3024,
		height: 1964,
		thumbnailWidth: 240,
		thumbnailHeight: 156,
		title: 'Open WebUI Interface',
		alt: 'Open WebUI showing the locally hosted Gemma model in the model selector.',
		caption:
			'Self-hosted Open WebUI interface providing access to locally hosted and cloud-based language models.',
	},
	{
		featured:
			'/images/projects/self-hosted-ai-chatbot/deepseek-assistants-featured.webp',
		src: '/images/projects/self-hosted-ai-chatbot/deepseek-assistants.webp',
		thumbnail:
			'/images/projects/self-hosted-ai-chatbot/deepseek-assistants-thumb.webp',
		width: 3024,
		height: 1964,
		thumbnailWidth: 240,
		thumbnailHeight: 156,
		title: 'Specialised DeepSeek Assistants',
		alt: 'Open WebUI model menu listing DeepSeek General, Coder, Documents and Tutor assistants.',
		caption:
			'Specialised DeepSeek assistants configured for general use, programming, document analysis and technical learning.',
	},
	{
		featured:
			'/images/projects/self-hosted-ai-chatbot/gemma-programming-tutor-featured.webp',
		src: '/images/projects/self-hosted-ai-chatbot/gemma-programming-tutor.webp',
		thumbnail:
			'/images/projects/self-hosted-ai-chatbot/gemma-programming-tutor-thumb.webp',
		width: 3024,
		height: 1964,
		thumbnailWidth: 240,
		thumbnailHeight: 156,
		title: 'Gemma 4 Programming Tutor',
		alt: 'Gemma programming tutor providing progressive Python hints about finding the longest sales streak.',
		caption:
			'Locally hosted Gemma 4 programming tutor demonstrating progressive, structured Python guidance.',
	},
	{
		featured:
			'/images/projects/self-hosted-ai-chatbot/ubuntu-monitoring-featured.webp',
		src: '/images/projects/self-hosted-ai-chatbot/ubuntu-monitoring.webp',
		thumbnail:
			'/images/projects/self-hosted-ai-chatbot/ubuntu-monitoring-thumb.webp',
		width: 1920,
		height: 1075,
		thumbnailWidth: 240,
		thumbnailHeight: 134,
		title: 'Ubuntu Server Monitoring',
		alt: 'Complete Ubuntu dashboard showing service statuses, CPU, memory, storage, uptime and monitoring metrics.',
		caption:
			'Ubuntu server dashboard combining service availability, resource monitoring and infrastructure status.',
	},
	{
		featured:
			'/images/projects/self-hosted-ai-chatbot/ubuntu-qwen-featured.webp',
		src: '/images/projects/self-hosted-ai-chatbot/ubuntu-qwen.webp',
		thumbnail: '/images/projects/self-hosted-ai-chatbot/ubuntu-qwen-thumb.webp',
		width: 1920,
		height: 1075,
		thumbnailWidth: 240,
		thumbnailHeight: 134,
		title: 'Ubuntu Qwen Local Inference',
		alt: 'Unsloth Studio running Qwen3.5 2B on Ubuntu and answering a question about context windows.',
		caption:
			'Qwen3.5 2B running locally through Unsloth Studio on the Ubuntu mini PC.',
	},
	{
		featured:
			'/images/projects/self-hosted-ai-chatbot/windows-gemma-featured.webp',
		src: '/images/projects/self-hosted-ai-chatbot/windows-gemma.webp',
		thumbnail:
			'/images/projects/self-hosted-ai-chatbot/windows-gemma-thumb.webp',
		width: 2559,
		height: 1439,
		thumbnailWidth: 240,
		thumbnailHeight: 135,
		title: 'Windows Gemma Local Inference',
		alt: 'Unsloth Studio running Gemma 4 12B and explaining Python data generation, cleaning and analytical calculations.',
		caption:
			'Gemma 4 12B running locally on the RTX 4070 desktop, demonstrating Python-based analytical tasks.',
	},
]
---

<Layout
	title="Self-Hosted AI Chatbot Platform"
	description="A private self-hosted AI platform integrating local and cloud-based language models."
>
	<article
		class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl space-y-10 p-8 duration-700 md:p-16"
	>
		<!-- Back Navigation -->
		<a
			href="/projects/"
			class="inline-flex items-center gap-2 text-sm text-primary hover:underline"
		>
			← Back to Projects
		</a>

		<!-- Header -->
		<header class="space-y-4">
			<div
				class="inline-flex rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary"
			>
				In Development · Private Deployment
			</div>

			<h1 class="text-3xl font-bold tracking-tight">
				Self-Hosted AI Chatbot Platform
			</h1>

			<p class="text-sm leading-relaxed text-muted-foreground">
				A self-hosted AI platform combining local and cloud-based language
				models, secure remote access, web search and document retrieval.
			</p>
		</header>

		<!-- System Architecture -->
		<section class="space-y-5" aria-labelledby="architecture-title">
			<h2 id="architecture-title" class="text-xl font-bold">
				System Architecture
			</h2>
			<div class="rounded-2xl border border-border/50 bg-muted/20 p-5">
				<div class="flex flex-col items-center text-center">
					<div class="w-5/6 rounded-xl border border-border bg-card p-4">
						<Icon
							name="mdi:web"
							size={20}
							class="mx-auto mb-2 text-primary"
							aria-hidden="true"
						/>
						<p class="text-sm font-semibold">Web Browser</p>
						<p class="mt-1 text-xs text-muted-foreground">Authorised users</p>
					</div>
					<Icon
						name="mdi:arrow-down"
						size={20}
						class="my-3 text-primary"
						aria-hidden="true"
					/>
					<div
						id="browser-access"
						class="w-5/6 rounded-xl border border-border bg-card p-4"
					>
						<Icon
							name="mdi:shield-check-outline"
							size={20}
							class="mx-auto mb-2 text-primary"
							aria-hidden="true"
						/>
						<p class="text-sm font-semibold">Cloudflare Access + Tunnel</p>
						<p class="mt-1 text-xs text-muted-foreground">
							Authentication and secure access
						</p>
					</div>
					<Icon
						name="mdi:arrow-down"
						size={20}
						class="my-3 text-primary"
						aria-hidden="true"
					/>
					<div
						id="ubuntu-server"
						class="w-full rounded-xl border border-border bg-card p-4"
					>
						<Icon
							name="mdi:server-outline"
							size={20}
							class="mx-auto mb-2 text-primary"
							aria-hidden="true"
						/>
						<h3 class="text-sm font-semibold">Ubuntu Mini PC</h3>
						<p class="mt-3 text-sm font-semibold text-primary">
							Open WebUI · Docker
						</p>
						<div
							id="ubuntu-local-inference"
							class="mt-4 border-t border-dashed border-border pt-4"
						>
							<h4 class="text-sm font-semibold">Local inference</h4>
							<p class="mt-2 text-xs text-muted-foreground">
								Unsloth Studio · <a
									href={modelLinks.qwen}
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Qwen3.5 2B model on Hugging Face (opens in a new tab)"
									class="hover:underline underline-offset-4 focus-visible:rounded-sm"
									>Qwen3.5 2B</a
								>
							</p>
						</div>
					</div>
					<div
						class="provider-connector relative h-8 w-full text-primary"
						aria-hidden="true"
					>
					</div>
					<div
						class="provider-grid relative grid w-full grid-cols-1 gap-x-3 gap-y-6 text-primary sm:grid-cols-2 sm:gap-y-3"
					>
						<div
							class="provider-card relative rounded-xl border border-border bg-card p-4"
						>
							<span class="provider-arrow" aria-hidden="true"></span>
							<Icon
								name="mdi:cloud-outline"
								size={20}
								class="mx-auto mb-2 text-primary"
								aria-hidden="true"
							/>
							<h4 class="text-sm font-semibold text-primary">OpenRouter</h4>
							<p class="mt-2 text-xs text-muted-foreground">Cloud models</p>
						</div>
						<div
							id="windows-inference"
							class="provider-card relative rounded-xl border border-border bg-card p-4"
						>
							<span class="provider-arrow" aria-hidden="true"></span>
							<Icon
								name="mdi:monitor"
								size={20}
								class="mx-auto mb-2 text-primary"
								aria-hidden="true"
							/>
							<h4 class="text-sm font-semibold text-primary">
								Windows Desktop
							</h4>
							<p class="mt-2 text-xs text-muted-foreground">
								<a
									href={modelLinks.gemma}
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Gemma 4 12B model on Hugging Face (opens in a new tab)"
									class="hover:underline underline-offset-4 focus-visible:rounded-sm"
									>Gemma 4 12B</a
								>
							</p>
						</div>
					</div>
				</div>
				<section
					class="mt-5 border-t border-border pt-5"
					aria-labelledby="administration-title"
				>
					<h3 id="administration-title" class="mb-3 text-sm font-semibold">
						Development &amp; Remote Administration
					</h3>
					<div
						id="macbook-client"
						class="rounded-xl border border-border bg-card p-4"
					>
						<h4
							class="flex items-center gap-2 text-sm font-semibold text-primary"
						>
							<Icon name="mdi:laptop" size={20} aria-hidden="true" /> MacBook Pro
						</h4>
						<p class="mt-3 text-xs text-muted-foreground">
							VS Code · Tailscale · SSH · Browser
						</p>
						<p class="mt-2 text-xs text-muted-foreground">
							Web access via Cloudflare; administration of Ubuntu via
							Tailscale/SSH.
						</p>
					</div>
				</section>
			</div>
		</section>

		<!-- Technical Implementation -->
		<section class="space-y-5">
			<h2 class="text-xl font-bold">Technical Implementation</h2>

			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				{
					features.map((feature) => (
						<div class="rounded-xl border border-border/50 bg-muted/20 p-4">
							<h3 class="mb-2 text-sm font-semibold">{feature.title}</h3>

							<p class="text-sm leading-relaxed text-muted-foreground">
								{feature.description}
							</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- Technology Stack -->
		<section class="space-y-4">
			<h2 class="text-xl font-bold">Technology Stack</h2>

			<div class="flex flex-wrap gap-2">
				{
					technologies.map((technology) => (
						<span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1.5 font-mono text-xs text-primary">
							{technology}
						</span>
					))
				}
			</div>
		</section>

		<!-- Screenshots -->
		{
			screenshots.length > 0 && (
				<section
					id="platform-screenshots"
					class="space-y-5"
					aria-labelledby="screenshots-title"
				>
					<h2 id="screenshots-title" class="text-xl font-bold">
						Platform Screenshots
					</h2>
					<p class="text-xs leading-relaxed text-muted-foreground">
						Select a thumbnail to explore the platform. Click the main image to
						enlarge.
					</p>
					<a
						data-gallery-featured
						href={screenshots[0].src}
						aria-label={`Enlarge ${screenshots[0].title}`}
						aria-haspopup="dialog"
						class="block aspect-[16/10] overflow-hidden rounded-xl border border-border bg-muted/20 hover:border-primary/50"
					>
						<img
							data-gallery-image
							src={screenshots[0].featured}
							alt={screenshots[0].alt}
							width={1200}
							height={Math.round(
								(screenshots[0].height * 1200) / screenshots[0].width
							)}
							loading="lazy"
							decoding="async"
							class="h-full w-full object-contain"
						/>
					</a>
					<div
						data-gallery-thumbnails
						role="group"
						aria-label="Choose a screenshot"
						class="flex min-w-0 gap-2 overflow-x-auto p-1"
					>
						{screenshots.map((screenshot, index) => (
							<button
								type="button"
								data-gallery-thumbnail
								data-src={screenshot.src}
								data-featured={screenshot.featured}
								data-title={screenshot.title}
								data-alt={screenshot.alt}
								data-caption={screenshot.caption}
								data-width={screenshot.width}
								data-height={screenshot.height}
								aria-label={`Show screenshot ${index + 1}: ${screenshot.title}`}
								aria-pressed={index === 0 ? 'true' : 'false'}
								class="w-20 shrink-0 overflow-hidden rounded-lg border border-border bg-muted/20 hover:border-primary/50 aria-pressed:border-primary sm:w-0 sm:min-w-16 sm:flex-1"
							>
								<img
									src={screenshot.thumbnail}
									alt=""
									width={screenshot.thumbnailWidth}
									height={screenshot.thumbnailHeight}
									loading="lazy"
									decoding="async"
									class="aspect-[16/10] w-full object-contain"
								/>
							</button>
						))}
					</div>
					<div aria-live="polite" aria-atomic="true" class="space-y-2">
						<h3 data-gallery-title class="text-sm font-semibold">
							{screenshots[0].title}
						</h3>
						<p
							data-gallery-caption
							class="text-xs leading-relaxed text-muted-foreground"
						>
							{screenshots[0].caption}
						</p>
					</div>
					<div class="flex items-center justify-between gap-3">
						<button
							data-gallery-previous
							type="button"
							aria-label="Previous screenshot"
							class="rounded-xl border border-border px-3 py-2 text-sm text-primary hover:bg-muted"
						>
							Previous
						</button>
						<span data-gallery-count class="text-xs text-muted-foreground">
							1 of {screenshots.length}
						</span>
						<button
							data-gallery-next
							type="button"
							aria-label="Next screenshot"
							class="rounded-xl border border-border px-3 py-2 text-sm text-primary hover:bg-muted"
						>
							Next
						</button>
					</div>
					<dialog
						id="screenshot-viewer"
						aria-labelledby="screenshot-viewer-title"
						aria-describedby="screenshot-viewer-caption"
						class="fixed inset-0 m-auto max-h-[92dvh] w-[calc(100%-2rem)] max-w-6xl overflow-y-auto rounded-2xl border border-border bg-card p-4 text-foreground shadow-main backdrop:bg-background/80 sm:p-6"
					>
						<div class="mb-4 flex items-start justify-between gap-4">
							<h3
								id="screenshot-viewer-title"
								class="text-base font-semibold"
							/>
							<button
								data-viewer-close
								type="button"
								autofocus
								class="shrink-0 rounded-xl border border-border px-3 py-2 text-sm text-primary hover:bg-muted"
							>
								Close
							</button>
						</div>
						<img
							data-viewer-image
							alt=""
							class="mx-auto h-auto max-h-[65dvh] w-auto max-w-full object-contain"
						/>
						<p
							id="screenshot-viewer-caption"
							class="mt-3 text-sm leading-relaxed text-muted-foreground"
						/>
						<div class="mt-4 flex flex-wrap items-center justify-between gap-3">
							<div class="flex items-center gap-3">
								<button
									data-viewer-previous
									type="button"
									aria-label="Previous screenshot"
									class="rounded-xl border border-border px-3 py-2 text-sm text-primary hover:bg-muted"
								>
									Previous
								</button>
								<span
									data-viewer-count
									aria-live="polite"
									class="text-xs text-muted-foreground"
								/>
								<button
									data-viewer-next
									type="button"
									aria-label="Next screenshot"
									class="rounded-xl border border-border px-3 py-2 text-sm text-primary hover:bg-muted"
								>
									Next
								</button>
							</div>
							<a
								data-viewer-original
								target="_blank"
								rel="noopener noreferrer"
								class="text-xs text-primary underline underline-offset-4"
							>
								Open full-size image{' '}
								<span class="sr-only">(opens in a new tab)</span>
							</a>
						</div>
					</dialog>
				</section>
			)
		}

		<!-- Private Deployment -->
		<footer class="rounded-xl border border-border/50 bg-muted/20 p-4">
			<p class="text-sm font-semibold">Private Deployment</p>

			<p class="mt-2 text-xs leading-relaxed text-muted-foreground">
				This application is privately hosted and is not available as a public
				demonstration.
			</p>
		</footer>
	</article>
</Layout>

<script>
	let galleryController: AbortController | undefined

	function setupScreenshotGallery() {
		galleryController?.abort()
		galleryController = new AbortController()
		const { signal } = galleryController
		const dialog = document.getElementById('screenshot-viewer')
		const thumbnails = [
			...document.querySelectorAll<HTMLButtonElement>(
				'[data-gallery-thumbnail]'
			),
		]
		const featured = document.querySelector<HTMLAnchorElement>(
			'[data-gallery-featured]'
		)
		const featuredImage = document.querySelector<HTMLImageElement>(
			'[data-gallery-image]'
		)
		const strip = document.querySelector<HTMLElement>(
			'[data-gallery-thumbnails]'
		)
		if (
			!(dialog instanceof HTMLDialogElement) ||
			!thumbnails.length ||
			!featured ||
			!featuredImage ||
			!strip
		)
			return
		const image = dialog.querySelector<HTMLImageElement>('[data-viewer-image]')!
		const title = dialog.querySelector<HTMLElement>('#screenshot-viewer-title')!
		const caption = dialog.querySelector<HTMLElement>(
			'#screenshot-viewer-caption'
		)!
		const count = dialog.querySelector<HTMLElement>('[data-viewer-count]')!
		const original = dialog.querySelector<HTMLAnchorElement>(
			'[data-viewer-original]'
		)!
		const close = dialog.querySelector<HTMLButtonElement>(
			'[data-viewer-close]'
		)!
		const galleryTitle = document.querySelector<HTMLElement>(
			'[data-gallery-title]'
		)!
		const galleryCaption = document.querySelector<HTMLElement>(
			'[data-gallery-caption]'
		)!
		const galleryCount = document.querySelector<HTMLElement>(
			'[data-gallery-count]'
		)!
		let index = 0

		const updateViewer = () => {
			const item = thumbnails[index].dataset
			image.src = item.src!
			image.alt = item.alt || ''
			image.width = Number(item.width)
			image.height = Number(item.height)
			title.textContent = item.title || ''
			caption.textContent = item.caption || ''
			count.textContent = `${index + 1} of ${thumbnails.length}`
			original.href = item.src!
		}
		const show = (next: number) => {
			index = (next + thumbnails.length) % thumbnails.length
			const item = thumbnails[index].dataset
			featured.href = item.src!
			featured.setAttribute('aria-label', `Enlarge ${item.title}`)
			featuredImage.src = item.featured!
			featuredImage.alt = item.alt || ''
			featuredImage.width = 1200
			featuredImage.height = Math.round(
				(Number(item.height) * 1200) / Number(item.width)
			)
			galleryTitle.textContent = item.title || ''
			galleryCaption.textContent = item.caption || ''
			galleryCount.textContent = `${index + 1} of ${thumbnails.length}`
			thumbnails.forEach((button, i) =>
				button.setAttribute('aria-pressed', String(i === index))
			)
			const button = thumbnails[index]
			strip.scrollLeft =
				button.offsetLeft -
				strip.offsetLeft -
				(strip.clientWidth - button.clientWidth) / 2
			// Fetch full-resolution images only when the lightbox is open.
			if (dialog.open) updateViewer()
		}
		thumbnails.forEach((button, i) =>
			button.addEventListener('click', () => show(i), { signal })
		)
		strip.addEventListener(
			'keydown',
			(event) => {
				if (!(event.target instanceof HTMLButtonElement)) return
				const current = thumbnails.indexOf(event.target)
				if (current < 0) return
				let next: number
				if (event.key === 'ArrowLeft') next = current - 1
				else if (event.key === 'ArrowRight') next = current + 1
				else if (event.key === 'Home') next = 0
				else if (event.key === 'End') next = thumbnails.length - 1
				else return
				event.preventDefault()
				show(next)
				thumbnails[index].focus({ preventScroll: true })
			},
			{ signal }
		)
		featured.addEventListener(
			'click',
			(event) => {
				if (
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey ||
					typeof dialog.showModal !== 'function'
				)
					return
				event.preventDefault()
				updateViewer()
				dialog.showModal()
				close.focus()
			},
			{ signal }
		)
		document
			.querySelector('[data-gallery-previous]')
			?.addEventListener('click', () => show(index - 1), { signal })
		document
			.querySelector('[data-gallery-next]')
			?.addEventListener('click', () => show(index + 1), { signal })
		close.addEventListener('click', () => dialog.close(), { signal })
		dialog
			.querySelector('[data-viewer-previous]')
			?.addEventListener('click', () => show(index - 1), { signal })
		dialog
			.querySelector('[data-viewer-next]')
			?.addEventListener('click', () => show(index + 1), { signal })
		dialog.addEventListener(
			'keydown',
			(event) => {
				if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
					event.preventDefault()
					show(index + (event.key === 'ArrowRight' ? 1 : -1))
				}
			},
			{ signal }
		)
		dialog.addEventListener(
			'click',
			(event) => {
				if (event.target === dialog) dialog.close()
			},
			{ signal }
		)
		dialog.addEventListener(
			'close',
			() => {
				if (featured.isConnected) featured.focus({ preventScroll: true })
			},
			{ signal }
		)
	}
	document.addEventListener('astro:page-load', setupScreenshotGallery)
	document.addEventListener('astro:before-swap', () => {
		const dialog = document.getElementById('screenshot-viewer')
		if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close()
		galleryController?.abort()
	})
</script>

