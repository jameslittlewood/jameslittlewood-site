---
interface Props {
	chart: string
	title: string
	description: string
	height?: string
	showRoleLegend?: boolean
	wide?: boolean
}

const {
	chart,
	title,
	description,
	height = 'h-64',
	showRoleLegend = false,
	wide = false,
} = Astro.props
---

<section
	class:list={[
		'min-w-0 rounded-2xl border border-border/60 bg-card p-4 sm:p-5',
		wide && 'lg:col-span-2',
	]}
>
	<div class="mb-4">
		<h3 class="text-sm font-bold">{title}</h3>
		<p class="mt-1 text-xs leading-relaxed text-muted-foreground">
			{description}
		</p>
	</div>
	<div
		class:list={['relative w-full overflow-hidden', height]}
		data-chart={chart}
		role="img"
		aria-label={`${title}. Chart data is also available in the table below.`}
	>
	</div>
	{
		showRoleLegend && (
			<div
				class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-muted-foreground"
				aria-label="Role colour key"
			>
				<span class="inline-flex items-center gap-1">
					<span
						class="h-2 w-2 rounded-full"
						style="background: var(--primary)"
						aria-hidden="true"
					/>
					Tank
				</span>
				<span class="inline-flex items-center gap-1">
					<span
						class="h-2 w-2 rounded-full"
						style="background: var(--callout-success)"
						aria-hidden="true"
					/>
					Healer
				</span>
				<span class="inline-flex items-center gap-1">
					<span
						class="h-2 w-2 rounded-full"
						style="background: var(--callout-warning)"
						aria-hidden="true"
					/>
					DPS
				</span>
				<span class="inline-flex items-center gap-1">
					<span
						class="h-2 w-2 rounded-full"
						style="background: var(--muted-foreground)"
						aria-hidden="true"
					/>
					Unknown
				</span>
			</div>
		)
	}
	<details class="mt-3 border-t border-border/50 pt-3">
		<summary
			class="cursor-pointer text-xs font-semibold text-primary focus-visible:rounded-sm"
		>
			View chart data table
		</summary>
		<div class="mt-3 overflow-x-auto" data-chart-table={chart}></div>
	</details>
</section>
