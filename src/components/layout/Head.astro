---
import site from "@/config/site";
import type { HeadProps } from "@/types";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

type Props = HeadProps;

const { title, description, image = site.ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!-- Global Metadata -->
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Blank favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg?v=3" />

  <!-- Theme Colour -->
  <!-- sRGB equivalents of the light/dark --background colours in global.css. -->
  <meta name="theme-color" content="#f8f8fe" />
  <meta name="msapplication-TileColor" content="#f8f8fe" />
  <script is:inline>
    (() => {
      const themeColours = { light: "#f8f8fe", dark: "#080813" };
      let preference;
      try {
        preference = localStorage.getItem("theme");
      } catch {
        // Fall back to the system preference if storage is unavailable.
      }
      const dark = preference === "dark" ||
        (preference !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);

      // Apply the preference before the first paint, including browser metadata.
      document.documentElement.classList.toggle("dark", dark);
      const syncThemeColour = (doc = document, isDark = document.documentElement.classList.contains("dark")) => {
        const colour = themeColours[isDark ? "dark" : "light"];
        for (const name of ["theme-color", "msapplication-TileColor"]) {
          doc.querySelector(`meta[name="${name}"]`)?.setAttribute("content", colour);
        }
      };
      syncThemeColour();

      // Astro retains the document root. Register these observers/listeners once.
      if (window.portfolioThemeMetadata) return;
      window.portfolioThemeMetadata = true;
      new MutationObserver(() => syncThemeColour()).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
      document.addEventListener("astro:before-swap", (event) => {
        const isDark = document.documentElement.classList.contains("dark");
        event.newDocument.documentElement.classList.toggle("dark", isDark);
        syncThemeColour(event.newDocument, isDark);
      });
      document.addEventListener("astro:after-swap", () => syncThemeColour());
    })();
  </script>

  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta name="twitter:creator" content={`@${site.meta.author}`} />
  <meta name="twitter:image" content={new URL(image, Astro.url)} />

  <!-- RSS Link -->
  <link
    rel="alternate"
    type="application/rss+xml"
    title={site.meta.title}
    href={new URL("rss.xml", Astro.site)}
  />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Pagefind -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>

  <!-- Font -->
  <Font cssVariable="--font-display" preload />

  <!-- View Transitions -->
  <ClientRouter />
</head>