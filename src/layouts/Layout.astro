---
import Sidebar from "@/components/layout/Sidebar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { HeadProps } from "@/types";

type Props = HeadProps & { wide?: boolean; standalone?: boolean };

const { wide = false, standalone = false, ...head } = Astro.props;
---

<BaseLayout {...head}>
  <div
    class:list={[
      "relative flex h-auto w-full flex-col overflow-hidden rounded-none border border-border bg-card shadow-main md:flex-row md:rounded-[2.5rem]",
      standalone ? "max-w-[1400px]" : wide ? "max-w-[100rem]" : "max-w-5xl",
    ]}
  >
    {!standalone && <Sidebar />}

    <main
      data-pagefind-body
      class:list={[
        "custom-scrollbar flex-1 overflow-x-hidden",
        !standalone && "overflow-y-auto md:h-200",
      ]}
    >
      <slot />
    </main>
  </div>
</BaseLayout>
